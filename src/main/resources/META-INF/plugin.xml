<idea-plugin>
    <id>dev.happs.ai-git-workflow-assistant</id>
    <name>AI Git Workflow Assistant</name>
    <vendor email="juriy.bulanov@gmail.com" url="https://github.com/h4pps">happs</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.AiGitWorkflowAssistantBundle</resource-bundle>

    <actions>
        <group id="AiGitWorkflowAssistant.Group"
               popup="true">
            <add-to-group group-id="Vcs.Operations.Popup" anchor="last"/>
            <action id="AiGitWorkflowAssistant.GenerateCommitMessage"
                    class="dev.happs.aigitassistant.action.GenerateCommitMessageAction"/>
            <action id="AiGitWorkflowAssistant.SuggestBranchName"
                    class="dev.happs.aigitassistant.action.SuggestBranchNameAction"/>
            <action id="AiGitWorkflowAssistant.SummarizeChanges"
                    class="dev.happs.aigitassistant.action.SummarizeChangesAction"/>
        </group>
    </actions>
</idea-plugin>
